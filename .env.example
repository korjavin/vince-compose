# ===========================================
# Vince Analytics Configuration
# ===========================================

# --- Docker Image ---
# Vendored image (updated weekly by vendor-images.yml workflow).
# To pin to a specific digest for reproducibility:
# Example: ghcr.io/korjavin/vince-vendor:latest@sha256:<digest>
# Check vendor-digests.log on the deploy branch for the latest digest.
VINCE_IMAGE=ghcr.io/korjavin/vince-vendor:latest

# --- Container Name ---
VINCE_CONTAINER_NAME=vince

# --- Volume Name ---
DATA_VOLUME_NAME=vince_data

# --- Network Names ---
TRAEFIK_NETWORK_NAME=traefik_default

# --- Traefik Configuration ---
VINCE_HOST=vince.yourdomain.com
TRAEFIK_CERTRESOLVER=myresolver

# Middlewares applied to the PROTECTED router (dashboard, login, admin,
# internal stats API). The public /api/event router never gets these — it
# stays open so tracker scripts can post events anonymously.
#
# Default assumes a forward-auth middleware (e.g. oauth2-proxy) is registered
# in Traefik as `forward-auth@docker`, paired with an `auth-errors@docker`
# error middleware. To use a different OAuth proxy, replace the chain. To
# disable auth entirely and rely only on Vince's own /login, set this to "".
VINCE_AUTH_MIDDLEWARES=auth-errors@docker,forward-auth@docker

# --- Vince Application ---
# Listen address inside the container. The container port published to
# Traefik is hardcoded to 8080 in docker-compose.yml; only change this
# if you also adjust loadbalancer.server.port.
VINCE_LISTEN=:8080

# --- Optional: bootstrap admin user ---
# On first deploy, set BOTH to create an admin account. After it exists,
# clear these values and redeploy so the credentials are not pinned in
# the stack config.
VINCE_ADMIN_NAME=
VINCE_ADMIN_PASSWORD=

# --- Optional: pre-create sites on startup (comma-separated) ---
# Example: VINCE_DOMAINS=blog.example.com,shop.example.com
VINCE_DOMAINS=

# --- Optional: demo site shown on the public landing page ---
VINCE_DEMO_URL=vinceanalytics.com

# --- Optional: enable /debug/pprof/* profiling endpoints ---
# Leave false unless you are actively debugging.
VINCE_PROFILE=false
